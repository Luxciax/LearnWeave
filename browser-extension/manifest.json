{
  "manifest_version": 3,
  "name": "LearnWeave Browser Helper",
  "version": "1.0.0",
  "description": "Adds structured web source context to the LearnWeave desktop capture flow.",
  "host_permissions": [
    "http://127.0.0.1:17832/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "zhihu-adapter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "LearnWeave Browser Helper"
  }
}
