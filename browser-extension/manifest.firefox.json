{
  "manifest_version": 3,
  "name": "LearnWeave Browser Helper",
  "version": "1.0.0",
  "description": "Adds structured web source context to the LearnWeave desktop capture flow.",
  "host_permissions": [
    "http://127.0.0.1:17832/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "desktop-bridge.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "zhihu-adapter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "learnweave-helper@local"
    }
  }
}
